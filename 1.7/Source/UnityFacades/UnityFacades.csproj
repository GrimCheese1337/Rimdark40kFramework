<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-time only. Builds an assembly named $(FacadeName) (default UnityEngine.CoreModule) that type-forwards every
    UnityEngine type to UnityStubs, so libraries still built against Unity (VEF 1.6) compile on 1.7. Never shipped.
  -->

  <PropertyGroup>
    <FacadeName Condition="'$(FacadeName)' == ''">UnityEngine.CoreModule</FacadeName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>$(FacadeName)</AssemblyName>
    <RootNamespace>UnityFacades</RootNamespace>
    <Configurations>Release</Configurations>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <IntermediateOutputPath>obj\$(FacadeName)\</IntermediateOutputPath>
    <OutputPath>bin\$(FacadeName)\</OutputPath>
    <RimWorldDir>..\..\..\..\..\</RimWorldDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldDir)Waylith.UnityCompat.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith.AssetBake">
      <HintPath>$(RimWorldDir)Waylith.AssetBake.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(RimWorldDir)Brutal.*.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
